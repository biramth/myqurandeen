{
  "name": "@qurandeen/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de myQurandeen - monolithe modulaire",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed/run-seed.ts",
    "db:seed:quran": "tsx src/database/seed/run-quran-import.ts",
    "db:seed:transliteration": "tsx src/database/seed/run-transliteration-import.ts",
    "db:seed:hadith": "tsx src/database/seed/run-hadith-import.ts",
    "db:seed:tafsir": "tsx src/database/seed/run-tafsir-import.ts",
    "db:seed:history": "tsx src/database/seed/run-history-seed.ts",
    "db:seed:schools": "tsx src/database/seed/run-schools-seed.ts",
    "db:seed:prophets": "tsx src/database/seed/run-prophets-seed.ts",
    "db:seed:concepts": "tsx src/database/seed/run-concepts-seed.ts",
    "db:seed:scholars": "tsx src/database/seed/run-scholars-seed.ts",
    "db:seed:learning": "tsx src/database/seed/run-learning-seed.ts",
    "db:seed:quiz": "tsx src/database/seed/run-quiz-seed.ts",
    "db:seed:library": "tsx src/database/seed/run-library-seed.ts",
    "db:seed:duas": "tsx src/database/seed/run-duas-seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@qurandeen/shared": "*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
