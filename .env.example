# --- Base de donnees ---
DATABASE_URL=postgres://qurandeen:qurandeen@localhost:5432/qurandeen

# --- API ---
API_PORT=3000
API_URL=http://localhost:3000
# Base publique de l'app : sert de base aux liens des emails (verification,
# reset, desabonnement) et au logo heberge. DANGER : une fois BREVO_API_KEY
# configuree, cette valeur ne doit PLUS etre locale (localhost) sinon le
# demarrage echoue - les emails reels contiendraient des liens inutilisables.
WEB_URL=http://localhost:5173
# CORS : origins supplementaires autorisees (sep. par des virgules), en plus de WEB_URL
# (ex. pour developper cote front en local alors que WEB_URL pointe vers le site public)
CORS_ORIGINS=
NODE_ENV=development

# --- Auth (JWT) ---
# Generer des secrets forts en production : `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- IA / RAG ---
# "gemini" (API distante, gratuite en usage modere) ou "ollama" (100% local,
# demande plus de ressources machine).
AI_BACKEND=gemini
AI_EMBEDDING_DIM=768

# Gemini : cle gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ollama (local, utilise seulement si AI_BACKEND=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Notifications push (rappels dua/lecture) ---
# Generer une paire avec `npx web-push generate-vapid-keys` (depuis apps/api).
# Sans ces cles, la fonctionnalite reste desactivee (voir /notifications/health).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Jeton secret partage avec le cron externe (cron-job.org, Render Cron Job...)
# qui declenche `POST /reminders/run` pour forcer une passe des planificateurs
# meme quand l'instance Render est en veille. Generer un secret fort :
# `openssl rand -base64 32`. Identique dans l'env de production uniquement.
# Optional : sans lui, l'endpoint repond 401.
REMINDER_RUN_TOKEN=change-me-reminder-run-token-strong

# --- Emails (verification, reset de mot de passe) via Brevo ---
# Cle API : https://app.brevo.com (SMTP & API > Cles API). Sans cle, les
# emails sont simules et journalises (logs) au lieu d'etre envoyes, pour le
# developpement. Brevo ne demande de verifier qu'une adresse email (clic sur
# un lien recu), pas un domaine entier - EMAIL_FROM doit correspondre a cette
# adresse verifiee.
BREVO_API_KEY=
EMAIL_FROM=myqurandeen <no-reply@qurandeen.app>
# Des que BREVO_API_KEY est renseignee, WEB_URL ci-dessus doit etre l'URL
# publique de l'app (les emails contiennent des liens /desabonnement, de
# verification et de reset bases dessus) - voir la section API.

# --- Google OAuth ("Continuer avec Google") - optionnel ---
# Identifiants OAuth 2.0 : https://console.cloud.google.com/apis/credentials
# GOOGLE_CALLBACK_URL doit etre une URI de redirection autorisee dans la console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Publication automatique reseaux sociaux (verset/hadith du jour) ---
# Chaque plateforme est optionnelle et independante : desactivee
# silencieusement tant que ses cles ne sont pas fournies (voir
# apps/api/src/modules/social/).
#
# X (Twitter) : creer une App sur https://developer.x.com (acces "Read and
# Write" obligatoire), recuperer l'API Key/Secret puis generer un Access
# Token/Secret pour le compte qui doit publier (pas juste l'app).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Facebook : creer une App sur https://developers.facebook.com, obtenir un
# jeton d'acces de PAGE longue duree (pas un jeton utilisateur - Meta les
# genere depuis l'outil "Graph API Explorer" puis "Extendre l'acces au token"
# ou via un echange long-lived) avec les permissions pages_manage_posts et
# pages_read_engagement. FACEBOOK_PAGE_ID est l'identifiant numerique de la
# Page (pas son nom).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
